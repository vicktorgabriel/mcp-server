# ============================================
# MCP LOCAL FULL CONTROL - CONFIGURACION
# ============================================

# Servidor HTTP local
PORT=3000
HOST=127.0.0.1

# Rutas permitidas, separadas por coma.
# Linux/macOS: ALLOWED_PATHS=/home/usuario/Proyectos,/tmp
# Windows: ALLOWED_PATHS=C:\Users\usuario\Proyectos,C:\Temp
# En el primer arranque start-mcp.sh ajusta esta ruta automáticamente.
ALLOWED_PATHS=..
WORKING_DIR=..

# 0 = restringido a ALLOWED_PATHS (recomendado para empezar)
# 1 = acceso a cualquier ruta que permita el usuario del sistema
MCP_FULL_ACCESS=0

# Exposición del servidor:
# ngrok = crea un túnel HTTPS público automáticamente
# direct = usas tu propia URL HTTPS pública/reverse proxy
# local  = sólo clientes MCP locales/stdio
MCP_EXPOSURE_MODE=ngrok

# Opcionales para el supervisor persistente.
# NGROK_DOMAIN permite usar un dominio reservado de ngrok.
NGROK_DOMAIN=
NGROK_CONFIG=
MCP_RUNTIME_LOG_MAX_BYTES=10485760
MCP_HEALTH_START_TIMEOUT_MS=30000

# Sólo para MCP_EXPOSURE_MODE=direct. Sin /mcp al final.
# Ejemplo: https://mcp.midominio.com
PUBLIC_BASE_URL=

# Opcional: exige Authorization: Bearer <token> en HTTP.
# Si tu cliente no soporta bearer, déjalo vacío.
MCP_AUTH_TOKEN=

# Rendimiento de búsqueda/lectura
MCP_FAST_MODE=1
SEARCH_CACHE_TTL_MS=60000
SEARCH_MAX_FILE_BYTES=524288
SEARCH_MAX_TOTAL_BYTES=16777216
SEARCH_SKIP_DIRS=node_modules,.git,dist,build,.next,.nuxt,.cache,coverage,.venv,venv,__pycache__,target,out
READ_BATCH_LIMIT=25

# Escritorio / imágenes
MCP_DESKTOP_ENABLED=1
MCP_INPUT_ENABLED=1
MCP_CONTROL_TIMEOUT_MS=120000
MCP_IMAGE_LIMIT_BYTES=26214400

SSE_HEARTBEAT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
ACTIVITY_LOG=activity.log
