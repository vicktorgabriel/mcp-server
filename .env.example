# ============================================
# CONFIGURACIÓN DEL MCP SERVER LOCAL
# ============================================

# Puerto donde correra el servidor HTTP local
PORT=3000
HOST=127.0.0.1

# Rutas permitidas, separadas por coma.
# Windows: ALLOWED_PATHS=C:\Users\tu-usuario\Proyectos,C:\Temp
# Linux/Mac: ALLOWED_PATHS=/home/tu-usuario,/tmp
ALLOWED_PATHS=/mnt/4tb-hdd/repo

# Opcional: exige Authorization: Bearer <token> en HTTP.
# Dejalo vacio si el cliente web no permite bearer tokens.
MCP_AUTH_TOKEN=

# Registro JSONL de actividad. Dejalo vacio para solo mostrar actividad en consola.
ACTIVITY_LOG=activity.log

# Directorio base cuando una herramienta recibe rutas relativas.
WORKING_DIR=/mnt/4tb-hdd/repo
