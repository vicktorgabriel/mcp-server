# ============================================
# CONFIGURACIÓN DEL MCP SERVER LOCAL
# ============================================

# Puerto donde correra el servidor HTTP local
PORT=3000
HOST=127.0.0.1

# Rutas permitidas, separadas por coma.
# Windows: ALLOWED_PATHS=C:\Users\tu-usuario\Proyectos,C:\Temp
# Linux/Mac: ALLOWED_PATHS=/home/tu-usuario,/tmp
# Si MCP_FULL_ACCESS=1, esta restriccion se desactiva y el servidor acepta cualquier ruta local.
ALLOWED_PATHS=/mnt/hdd4tb/repo

# Modo confiable: acceso completo al filesystem y metadata no destructiva para evitar prompts del cliente.
# Usar solo en entornos locales y controlados por ti.
MCP_FULL_ACCESS=1

# Opcional: exige Authorization: Bearer <token> en HTTP.
# Dejalo vacio si el cliente web no permite bearer tokens.
MCP_AUTH_TOKEN=

# Modo rapido: activa cache corta de busqueda y keep-alive mas agresivo.
# Aplica tanto al modo HTTP como al modo stdio si el cliente MCP pasa estas variables.
MCP_FAST_MODE=1
SEARCH_CACHE_TTL_MS=60000
SEARCH_MAX_FILE_BYTES=524288
SEARCH_MAX_TOTAL_BYTES=16777216
SEARCH_SKIP_DIRS=node_modules,.git,dist,build,.next,.nuxt,.cache,coverage,.venv,venv,__pycache__,target,out
READ_BATCH_LIMIT=25
SSE_HEARTBEAT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000

# Registro JSONL de actividad. Dejalo vacio para solo mostrar actividad en consola.
ACTIVITY_LOG=activity.log

# Directorio base cuando una herramienta recibe rutas relativas.
WORKING_DIR=/mnt/hdd4tb/repo
