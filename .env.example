# ==========================================================
# MCP LOCAL FULL CONTROL - CONFIGURACION LOCAL (NO VERSIONAR)
# ==========================================================
# En una instalación nueva, ./start-mcp.sh completa este archivo mediante
# preguntas. .env y .private/ están excluidos de Git.

MCP_SETUP_COMPLETE=0
MCP_SETUP_VERSION=6

# Servidor HTTP local
PORT=3000
HOST=127.0.0.1

# Rutas permitidas, separadas por coma.
# Linux/macOS: ALLOWED_PATHS=/home/usuario/Proyectos,/tmp
# Windows: ALLOWED_PATHS=C:\Users\usuario\Proyectos,C:\Temp
ALLOWED_PATHS=..
WORKING_DIR=..

# 0 = restringido a ALLOWED_PATHS (recomendado)
# 1 = acceso a cualquier ruta permitida por el usuario del sistema
MCP_FULL_ACCESS=0

# Herramientas publicadas: read_only, developer, administrator, full o custom.
# El asistente explica cada perfil. developer es el valor recomendado.
MCP_ACCESS_PROFILE=developer
# Sólo para custom: grupos separados por coma.
MCP_ACCESS_GROUPS=
# Filtros avanzados opcionales por nombre exacto de herramienta.
MCP_TOOL_ALLOWLIST=
MCP_TOOL_DENYLIST=

# Cuenta del sistema usada por el proceso MCP.
# 0 = usuario normal/dueño del repo (recomendado)
# 1 = root; requiere confirmación explícita durante la configuración
MCP_RUN_AS_ROOT=0
MCP_SERVICE_USER=

# 1 = las herramientas críticas exigen frases como DELETE/APPLY PACKAGES
# 0 = omite esas frases; requiere confirmación de riesgo en el asistente
MCP_CRITICAL_CONFIRMATIONS=1

# Publicación:
# ngrok = HTTPS automático, recomendado para ChatGPT
# direct = IP pública o reverse proxy administrado por vos
# local = sólo clientes locales; ChatGPT Web no puede conectarse
MCP_EXPOSURE_MODE=ngrok

# ngrok. El asistente guarda el authtoken en .private/ngrok.yml, no aquí.
NGROK_BIN=
NGROK_CONFIG=
# URL sin /mcp. Ejemplo genérico: https://mi-equipo.ngrok.dev
NGROK_URL=
# Compatibilidad con versiones anteriores
NGROK_DOMAIN=

# Directo/reverse proxy. URL sin /mcp.
# HTTP con IP puede servir a clientes compatibles, pero OAuth/ChatGPT requieren HTTPS.
PUBLIC_BASE_URL=

# URL canónica del servidor. El asistente la sincroniza con ngrok/direct.
MCP_PUBLIC_BASE_URL=

# Seguridad HTTP: oauth (recomendado), bearer o none.
MCP_AUTH_MODE=oauth
# Marcas que sólo se establecen después de una confirmación explícita.
MCP_ALLOW_UNSAFE_NO_AUTH=0
MCP_ALLOW_INSECURE_HTTP_AUTH=0

# OAuth 2.1 integrado: autorización por código, PKCE S256 y refresh token.
# La contraseña, los códigos y los tokens se guardan solamente como hashes.
# El estado no secreto queda en un archivo privado no versionado con modo 0600.
MCP_OAUTH_STORE=.private/oauth-state.json
# ChatGPT actual soporta CIMD y DCR. CIMD evita client_id locales obsoletos.
MCP_OAUTH_CIMD=1
MCP_OAUTH_CIMD_HOSTS=chatgpt.com
MCP_OAUTH_CIMD_TIMEOUT_MS=5000
MCP_OAUTH_CIMD_CACHE_TTL=21600
# Cache de las claves públicas usadas para verificar private_key_jwt de ChatGPT.
MCP_OAUTH_JWKS_CACHE_TTL=3600
MCP_OAUTH_DYNAMIC_REGISTRATION=1
MCP_OAUTH_ACCESS_TOKEN_TTL=3600
MCP_OAUTH_REFRESH_TOKEN_TTL=2592000
MCP_OAUTH_CODE_TTL=300

# Compatibilidad Bearer. El asistente guarda el secreto en un archivo privado.
MCP_AUTH_TOKEN_FILE=.private/bearer-token.txt
# Sólo para migrar configuraciones antiguas; preferí MCP_AUTH_TOKEN_FILE.
MCP_AUTH_TOKEN=

# Actividad legible y diagnóstico privado. Los archivos rotan al alcanzar el límite.
MCP_HUMAN_LOG=.runtime/events.log
ACTIVITY_LOG=.runtime/activity.ndjson
MCP_ERROR_LOG=.runtime/errors.log
MCP_RUNTIME_LOG_MAX_BYTES=10485760
MCP_HEALTH_START_TIMEOUT_MS=30000

# Aviso de actualizaciones. La comprobación se realiza en segundo plano.
MCP_UPDATE_CHECK=1
MCP_UPDATE_CHECK_TTL_SECONDS=900
MCP_UPDATE_CHECK_TIMEOUT_MS=5000

# Rendimiento de búsqueda/lectura
MCP_FAST_MODE=1
SEARCH_CACHE_TTL_MS=60000
SEARCH_MAX_FILE_BYTES=524288
SEARCH_MAX_TOTAL_BYTES=16777216
SEARCH_SKIP_DIRS=node_modules,.git,dist,build,.next,.nuxt,.cache,coverage,.venv,venv,__pycache__,target,out
READ_BATCH_LIMIT=25

# Escritorio / imágenes
MCP_DESKTOP_ENABLED=1
MCP_INPUT_ENABLED=1
MCP_CONTROL_TIMEOUT_MS=120000
MCP_IMAGE_LIMIT_BYTES=26214400

SSE_HEARTBEAT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
